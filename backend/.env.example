PORT=5000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. A GitHub personal access token (no scopes needed) raises the
# GitHub API rate limit and unlocks the contribution streak/calendar data.
# Without it, GitHub stats still work but skip streak/total contributions.
GITHUB_TOKEN=

# Optional. SMTP credentials for habit reminder emails. Without these,
# reminders still work in-browser (Notification API) but no email is sent.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=an App Password (not your normal password) from
# https://myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
